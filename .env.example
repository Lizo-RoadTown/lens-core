# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# The database this lab runs against — INJECTED, never hardcoded in code.
LENS_DB_URL=

# Tapestry consuming-project wiring
LOOM_PROJECT_ID=lens-core
# loom-memory auth (the key lives in your ~/.claude/settings.json; referenced by name)
# TAPESTRY_MEMORY_API_KEY is read from your environment, not committed here.

# OpenTelemetry (optional) — paste from your Tapestry .env to send hook telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=loom-discipline
